  "cards": [
    {
      "dot": "cyan",
      "title": "启动顺序",
      "items": [
        "Gateway::start 先 refresh grants、阻塞首轮 probe，再 HttpMcp::startListen",
        "停机：pauseAccept → 拒新请求 → 排空队列 → drain_timeout_ms 后 quit"
      ]
    },
    {
      "dot": "amber",
      "title": "线程契约",
      "items": [
        "IO loop 禁止 stat/open grants、POST OTLP、yaml-cpp、cpp-httplib",
        "worker 完成必须 EventLoop::queueInLoop 再碰 Call / responded_"
      ]
    },
    {
      "dot": "rose",
      "title": "分层",
      "items": [
        "CMake 把每层编成独立 static lib；pipeline 故意不链 frontend",
        "scripts/check_layers.sh 禁止跨层 include 回潮"
      ]
    }
