# TwigRPC 统一配置入口
# 使用：复制为 .env 放到进程工作目录（或用 TWIGRPC_ENV=/path/to/.env 指定）。
# 优先级：命令行参数 > 进程环境变量 > .env 文件 > 代码默认值。
# 格式：每行 KEY=VALUE，# 注释，值可带成对引号。

# ---- 服务端（math_server / kv_server）----
# 监听地址：0.0.0.0 = 所有网卡；收紧到内网网卡可减暴露面
#TWIGRPC_LISTEN_IP=0.0.0.0
# 监听端口（math_server / kv_server；registryd 用独立的 TWIGRPC_REGISTRY_PORT）
#TWIGRPC_PORT=9000
# 注册中心自身监听端口（registryd 进程读）
#TWIGRPC_REGISTRY_PORT=8500
# 注册中心地址 ip:port（支持 DNS 主机名；留空/缺省 = 不接入注册中心）
#TWIGRPC_REGISTRY=127.0.0.1:8500
# 向注册中心上报的本机 IP：留空 = 自动推导「本机→注册中心」出口 IP（推荐）。
# 仅多网卡/NAT 后面（推导结果不是客户端可达地址）时才需显式指定。
#TWIGRPC_ADVERTISE_IP=
# 管理端口（/metrics /healthz /stats），0 = 不启
#TWIGRPC_ADMIN_PORT=0
# sub-reactor 数与 handler 线程数
#TWIGRPC_IO_THREADS=2
#TWIGRPC_WORKERS=4

# ---- kv_server 专用：Set handler 模拟业务 IO 的毫秒数 ----
#TWIGRPC_SLEEP_MS=0

# ---- 客户端（math_client / bench）目标地址 ----
#TWIGRPC_SERVER_IP=127.0.0.1
#TWIGRPC_SERVER_PORT=9000
